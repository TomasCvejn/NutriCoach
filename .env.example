# Copy to .env.local. Without the Google pair the login page offers dev login only (non-production).
# Google OAuth client (Web application); authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://nutricoach.example.com (dev: http://localhost:3000)
BETTER_AUTH_URL=
# SQLite file; defaults to file:./dev.db
# DATABASE_URL=file:./dev.db
# Open Food Facts; defaults to https://world.openfoodfacts.org (e2e points it at a closed port)
# OFF_BASE_URL=https://world.openfoodfacts.org
