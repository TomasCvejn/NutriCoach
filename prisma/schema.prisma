generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Better Auth core tables. role / active / timezone / locale are Better Auth additional fields (src/lib/auth.ts).
model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  role             String // ROLES
  active           Boolean           @default(true)
  timezone         String            @default("Europe/Prague")
  locale           String            @default("cs")
  welcomeText      String? // coach only: the first onboarding screen; null → the i18n default
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  client           Client?           @relation("ClientUser")
  clients          Client[]          @relation("CoachClients")
  invites          Invite[]
  notifications    Notification[]
  foods            Food[]
  recipes          Recipe[]
  fuelingTemplates FuelingTemplate[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // always null (Google only); Better Auth's runtime schema check fails every request without it
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Client {
  id                  String               @id @default(cuid())
  userId              String               @unique
  user                User                 @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)
  coachId             String
  coach               User                 @relation("CoachClients", fields: [coachId], references: [id])
  trackingMode        String               @default("CALORIES") // TRACKING_MODES
  createdAt           DateTime             @default(now())
  invite              Invite?
  history             HistoryEvent[]
  coachNotes          CoachNote[]
  targets             NutritionTarget[]
  planMeals           PlanMeal[]
  planRecommendations PlanRecommendation[]
  planSpecifics       String? // the plan's "specifics for this client" (nutrition.md)

  // Onboarding (/onboarding): the current step, an index into ONBOARDING_STEPS, so a reload resumes; /app redirects until completed.
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  preferredTrackingMode String? // TRACKING_MODES; the client's wish for the coach, and the mode itself when the invite set none
  checkInWeekday        Int       @default(1) // ISO weekday of the weekly check-in, 1 = Monday; the coach sets it

  // Profile (onboarding-profile.md), every field optional. Validated by PROFILE_SECTIONS (src/lib/profile.ts).
  sex              String? // SEXES
  birthDate        String? // YYYY-MM-DD
  heightCm         Int?
  weightKg         Float?
  phone            String?
  primaryGoal      String? // GOALS
  targetWeightKg   Float?
  targetDate       String? // YYYY-MM-DD
  successText      String?
  likedFoods       String?
  dislikedFoods    String?
  mealsPerDay      Int?
  dietType         String? // DIET_TYPES
  allergens        Json              @default("[]") // ALLERGENS[]
  allergiesNote    String?
  restrictions     String?
  sports           String? // set → the Training section is on (clientFeatures)
  sportLevel       String? // SPORT_LEVELS
  sessionsPerWeek  Int?
  sessionMinutes   Int?
  healthConditions String?
  medications      String?
  otherInfo        String?
  nutritionDays    NutritionDay[]
  foodEntries      FoodEntry[]
  portionLogs      PortionLog[]
  guidanceLogs     GuidanceLog[]
  savedRecipes     SavedRecipe[]
  fluidLogs        FluidLog[]
  drinkPresets     DrinkPreset[]
  checkIns         CheckIn[]
  bodyComps        BodyComp[]
  trainingSessions TrainingSession[]

  @@index([coachId])
}

// Pending until used, revoked or expired. The token stays readable so the coach can copy the link again.
model Invite {
  id           String    @id @default(cuid())
  token        String    @unique
  coachId      String
  coach        User      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name         String
  email        String? // lowercased; set → the Google email must match
  trackingMode String? // TRACKING_MODES; null → the client picks in onboarding
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  clientId     String?   @unique // the client it created (onboarding reads what the invite set)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([coachId])
}

// In-app notifications. Written only by notify() (src/lib/notifications.ts); a key dedupes lazy ones (check-in due, phase started).
// SQLite treats NULL keys as distinct, so notifications without a key never collide.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // NOTIFICATION_TYPES
  payload   Json // NotificationPayloads[type]
  key       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, type, key])
}

// The coach-only client history (coach.md): rows only for plan / target / tracking mode changes. Notes, check-ins and
// competitions are read from their own tables and merged into the feed by date.
model HistoryEvent {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String // HISTORY_TYPES
  date      String // YYYY-MM-DD in the client's timezone
  payload   Json // HistoryPayloads[type]
  createdAt DateTime @default(now())

  @@index([clientId, date])
}

// The coach's private notes on a client (coach.md): never readable by the client, so nothing under /app loads them.
model CoachNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  type      String // NOTE_TYPES
  text      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, date])
}

// Daily targets per day type (nutrition.md), one row per (client, day type, effective-from day); history = the older rows.
// A row holds every mode's numbers, so switching the tracking mode keeps the others. Null = not set.
model NutritionTarget {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dayType       String // DAY_TYPES
  effectiveFrom String // YYYY-MM-DD
  // CALORIES
  kcal          Int?
  protein       Int? // g
  carbs         Int? // g
  fat           Int? // g
  fiber         Int? // g
  sodium        Int? // mg
  // PORTIONS: hand portions per day, in 0.5 steps
  palms         Float? // protein
  hands         Float? // carbs, cupped hands
  fists         Float? // vegetables
  thumbs        Float? // fats
  // All modes
  fluidMl       Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([clientId, dayType, effectiveFrom])
}

// The plan's meals per day type, in order (nutrition.md). Logged entries keep the slot name as a snapshot, so changing
// or deleting a meal never moves old entries.
model PlanMeal {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dayType   String // DAY_TYPES
  position  Int
  name      String
  timeHint  String? // free text: "7:00", "before training"
  guidance  String?
  // PORTIONS: hand portions for this meal, in 0.5 steps
  palms     Float?
  hands     Float?
  fists     Float?
  thumbs    Float?
  note      String?
  recipeIds Json     @default("[]") // the coach's recipes offered for this meal (clients see the published ones)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, dayType, position])
}

// The coach's recommendations in the plan, in order ("Protein in every meal").
model PlanRecommendation {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, position])
}

// One client's calendar day of nutrition: the day-type override (client or coach) and the client's note for the coach.
// The day's logs reference the client and the date, not this row, so it exists only once something is set.
model NutritionDay {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date            String // YYYY-MM-DD in the client's timezone
  dayTypeOverride String? // DAY_TYPES; null = derived (competition > session > rest)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, date])
}

// A food to log (nutrition.md): from Open Food Facts (shared by everyone, upserted on first use), a coach's own (their
// clients see it) or a client's own (the client and their coach see it). Nutrients per 100 g; logged entries keep a
// snapshot, so editing or deleting a food never changes past logs.
model Food {
  id        String      @id @default(cuid())
  source    String // FOOD_SOURCES
  ownerId   String? // COACH / CLIENT: the user who made it; OFF: null
  owner     User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  offCode   String?     @unique // OFF: the product code, so upserts are idempotent
  name      String
  brand     String?
  // per 100 g
  kcal      Float
  protein   Float // g
  carbs     Float // g
  fat       Float // g
  fiber     Float? // g
  sodium    Float? // mg
  servings  Json        @default("[]") // [{ label: "1 piece", grams: 60 }]
  entries   FoodEntry[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([ownerId])
}

// One logged item of a CALORIES day: a snapshot of the name and the nutrients of the amount eaten, so editing or deleting
// the food (or the plan's meals) never changes it. Quick adds have no food and no grams. `slot` is the meal's name.
model FoodEntry {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD in the client's timezone
  slot         String
  foodId       String? // for "recent foods" only
  food         Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name         String? // null = quick add
  brand        String?
  grams        Float?
  servingLabel String? // logged by serving: its label, and servingCount of them
  servingCount Float?
  // of the amount
  kcal         Float
  protein      Float
  carbs        Float
  fat          Float
  fiber        Float?
  sodium       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId, date])
}

// A PORTIONS day: hand portions eaten in one meal slot, in 0.5 steps. A row exists only while some count is above zero.
model PortionLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD in the client's timezone
  slot      String // the meal's name, as on food entries
  palms     Float    @default(0)
  hands     Float    @default(0)
  fists     Float    @default(0)
  thumbs    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, date, slot])
}

// A GUIDANCE day: per planned meal "followed? yes / partly / no" and an optional note. A row exists only while one is set.
model GuidanceLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD in the client's timezone
  slot      String // the meal's name
  followed  String? // FOLLOWED
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, date, slot])
}

// A coach's recipe (recipes.md). Clients see only their coach's PUBLISHED ones. Ingredients, steps and substitutions are
// ordered JSON lists: ingredients [{ foodId?, name, grams? }] (a food from the coach's library or OFF, or free text, which
// has no nutrition), steps [string], substitutions [{ instead, use, note? }]. Nutrition is computed from the foods.
model Recipe {
  id            String        @id @default(cuid())
  coachId       String
  coach         User          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name          String
  status        String        @default("DRAFT") // RECIPE_STATUSES
  categories    Json          @default("[]") // RECIPE_CATEGORIES[]
  prepMinutes   Int?
  servings      Int           @default(1)
  dietFlags     Json          @default("[]") // DIET_FLAGS[]
  allergens     Json          @default("[]") // ALLERGENS[]
  ingredients   Json          @default("[]")
  steps         Json          @default("[]")
  substitutions Json          @default("[]")
  savedBy       SavedRecipe[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([coachId, status])
}

// A client's "Saved" recipes (the heart on a recipe card).
model SavedRecipe {
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([clientId, recipeId])
}

// Hydration (training.md): what the client drank on a day. Only the client writes it; the coach reads it in the day.
model FluidLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD in the client's timezone
  ml        Int
  drinkType String // DRINK_TYPES
  sodium    Int? // mg
  carbs     Int? // g
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, date])
}

// "My drinks": a client's saved drinks, logged with one tap.
model DrinkPreset {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  ml        Int
  drinkType String // DRINK_TYPES
  sodium    Int?
  carbs     Int?
  createdAt DateTime @default(now())
}

// The weekly check-in (check-ins.md) for the period starting on its due date (the check-in weekday). One per period.
// answers: { [CHECK_IN_SCALES]: { score: 1–10, comment? } }. reviewedAt is set when the coach publishes feedback.
model CheckIn {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dueDate        String // YYYY-MM-DD, the check-in weekday that opened the period
  answers        Json
  questions      String?
  // The coach's feedback, published together with reviewedAt.
  response       String?
  changes        String?
  newGoals       String?
  nextSteps      String?
  reviewedAt     DateTime?
  feedbackSeenAt DateTime? // the client opened the published feedback
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clientId, dueDate])
}

// An occasional body-composition entry, added by the client or their coach (progress.md).
model BodyComp {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD
  method     String
  weightKg   Float?
  bodyFatPct Float?
  leanMassKg Float? // as entered; lib/body-comp.ts computes it from weight and body fat when empty
  waistCm    Float?
  hipsCm     Float?
  chestCm    Float?
  thighCm    Float?
  armCm      Float?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId, date])
}

// A training session (training.md), created by the client or their coach; "repeat weekly" writes independent rows.
model TrainingSession {
  id                String           @id @default(cuid())
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date              String // YYYY-MM-DD
  startTime         String? // HH:MM
  type              String
  sport             String?
  durationMin       Int
  intensity         String
  description       String?
  // After the session (Performance in progress.md).
  rpe               Int?
  felt              Int?
  note              String?
  // The coach's fueling override for this session: a template from their library (null = the matching one).
  fuelingTemplateId String?
  fuelingTemplate   FuelingTemplate? @relation(fields: [fuelingTemplateId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([clientId, date])
}

// A coach's fueling template (training.md): when it applies to a session, and what to eat and drink before, during and
// after. lib/fueling.ts picks a session's template.
model FuelingTemplate {
  id                  String            @id @default(cuid())
  coachId             String
  coach               User              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name                String
  // Matching rule (all must hold): session types ([] = any), duration bounds (inclusive), a minimum intensity.
  sessionTypes        Json              @default("[]")
  minDurationMin      Int?
  maxDurationMin      Int?
  minIntensity        String?
  priority            Int               @default(0) // the highest matching one wins
  pre                 Json              @default("[]") // { timing, text, carbs? }[]
  duringCarbsPerHour  Int?
  duringFluidPerHour  Int? // ml
  duringSodiumPerHour Int? // mg
  duringText          String?
  postWithinMin       Int?
  postProtein         Int?
  postCarbs           Int?
  postFluidText       String?
  sessions            TrainingSession[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}
