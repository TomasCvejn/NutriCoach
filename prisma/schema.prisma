generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Better Auth core tables. role / active / timezone / locale are Better Auth additional fields (src/lib/auth.ts).
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String // ROLES
  active        Boolean   @default(true)
  timezone      String    @default("Europe/Prague")
  locale        String    @default("cs")
  welcomeText   String? // coach only: the first onboarding screen; null → the i18n default
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  client        Client?   @relation("ClientUser")
  clients       Client[]  @relation("CoachClients")
  invites       Invite[]
  notifications Notification[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // always null (Google only); Better Auth's runtime schema check fails every request without it
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Client {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)
  coachId      String
  coach        User     @relation("CoachClients", fields: [coachId], references: [id])
  trackingMode String   @default("CALORIES") // TRACKING_MODES
  createdAt    DateTime @default(now())
  invite       Invite?
  history      HistoryEvent[]
  coachNotes   CoachNote[]

  // Onboarding (/onboarding): the current step, an index into ONBOARDING_STEPS, so a reload resumes; /app redirects until completed.
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  preferredTrackingMode String? // TRACKING_MODES; the client's wish for the coach, and the mode itself when the invite set none

  // Profile (onboarding-profile.md), every field optional. Validated by PROFILE_SECTIONS (src/lib/profile.ts).
  sex              String? // SEXES
  birthDate        String? // YYYY-MM-DD
  heightCm         Int?
  weightKg         Float?
  phone            String?
  primaryGoal      String? // GOALS
  targetWeightKg   Float?
  targetDate       String? // YYYY-MM-DD
  successText      String?
  likedFoods       String?
  dislikedFoods    String?
  mealsPerDay      Int?
  dietType         String? // DIET_TYPES
  allergens        Json     @default("[]") // ALLERGENS[]
  allergiesNote    String?
  restrictions     String?
  sports           String? // set → the Training section is on (clientFeatures)
  sportLevel       String? // SPORT_LEVELS
  sessionsPerWeek  Int?
  sessionMinutes   Int?
  healthConditions String?
  medications      String?
  otherInfo        String?

  @@index([coachId])
}

// Pending until used, revoked or expired. The token stays readable so the coach can copy the link again.
model Invite {
  id           String    @id @default(cuid())
  token        String    @unique
  coachId      String
  coach        User      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name         String
  email        String? // lowercased; set → the Google email must match
  trackingMode String? // TRACKING_MODES; null → the client picks in onboarding
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  clientId     String?   @unique // the client it created (onboarding reads what the invite set)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([coachId])
}

// In-app notifications. Written only by notify() (src/lib/notifications.ts); a key dedupes lazy ones (check-in due, phase started).
// SQLite treats NULL keys as distinct, so notifications without a key never collide.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // NOTIFICATION_TYPES
  payload   Json // NotificationPayloads[type]
  key       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, type, key])
}

// The coach-only client history (coach.md): rows only for plan / target / tracking mode changes. Notes, check-ins and
// competitions are read from their own tables and merged into the feed by date.
model HistoryEvent {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String // HISTORY_TYPES
  date      String // YYYY-MM-DD in the client's timezone
  payload   Json // HistoryPayloads[type]
  createdAt DateTime @default(now())

  @@index([clientId, date])
}

// The coach's private notes on a client (coach.md): never readable by the client, so nothing under /app loads them.
model CoachNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  type      String // NOTE_TYPES
  text      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, date])
}
